---
import { beruf, ausbildung, zeitraum } from "../../data/werdegang";
import Panel from "./Panel.astro";
import Legende from "./Legende.astro";

/** Zeitachse vom frühesten Start bis ins nächste Jahr, damit laufende Balken sichtbar Luft haben. */
const stationen = [...beruf, ...ausbildung].sort((a, b) => a.von - b.von || (a.bis ?? 9999) - (b.bis ?? 9999));
const start = Math.min(...stationen.map((s) => s.von));
const ende = new Date().getFullYear() + 1;
const jahre = Array.from({ length: ende - start }, (_, i) => start + i);
const pos = (jahr: number) => ((jahr - start) / (ende - start)) * 100;
---

<Panel titel="werdegang.gantt" id="werdegang" class="gantt">
  <Legende slot="aktion" nur={[...new Set(stationen.map((s) => s.kontext))]} />
  <h2 class="visually-hidden">Werdegang</h2>
  <div class="chart" style={`--jahre: ${jahre.length}`}>
  <ol class="zeilen">
    {
      stationen.map((s) => (
        <li class="zeile" data-kontext={s.kontext}>
          <span class="name">
            <strong>{s.titel}</strong>
            <span class="ort">{s.ort}</span>
          </span>
          <span class="spur">
            {s.meilenstein ? (
              <span
                class="punkt"
                style={`left: ${pos(s.von + 0.5)}%`}
                tabindex="0"
                data-tip={`${zeitraum(s)} · ${s.ort}`}
                aria-label={`${s.titel}, ${s.ort}, ${zeitraum(s)}`}
              />
            ) : (
              <span
                class:list={["balken", { laufend: s.bis === null }]}
                style={`left: ${pos(s.von)}%; width: ${pos(s.bis ?? ende) - pos(s.von)}%`}
                tabindex="0"
                data-tip={`${zeitraum(s)} · ${s.ort}`}
                aria-label={`${s.titel}, ${s.ort}, ${zeitraum(s)}`}
              />
            )}
          </span>
        </li>
      ))
    }
  </ol>
  <div class="achse" aria-hidden="true">
    <span></span>
    <span class="jahre">
      {jahre.map((j) => <span>’{String(j).slice(2)}</span>)}
    </span>
  </div>
  </div>

</Panel>

<style>
  .zeilen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
  }
  .zeile,
  .achse {
    display: grid;
    gap: 0.25rem;
  }
  @media (min-width: 40rem) {
    .zeile,
    .achse {
      grid-template-columns: 13rem 1fr;
      gap: 1rem;
      align-items: center;
    }
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    font-size: 0.875rem;
    line-height: 1.3;
  }
  .ort {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  /* Spur mit Jahresrastern */
  .spur {
    position: relative;
    height: 1.25rem;
    background-image: linear-gradient(to right, var(--line) 1px, transparent 1px);
    background-size: calc(100% / var(--jahre)) 100%;
    border-right: 1px solid var(--line);
  }
  .balken,
  .punkt {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--k);
    outline-offset: 2px;
  }
  .balken {
    height: 0.75rem;
    border-radius: 4px;
    /* 2px Oberflächen-Abstand zwischen direkt angrenzenden Balken */
    box-shadow: 0 0 0 2px var(--surface);
  }
  .balken.laufend {
    background: linear-gradient(to right, var(--k) 60%, transparent);
  }
  .punkt {
    width: 0.75rem;
    height: 0.75rem;
    margin-left: -0.375rem;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--surface);
  }
  /* Tooltip bei Hover und Tastaturfokus */
  .balken::after,
  .punkt::after {
    content: attr(data-tip);
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.5rem);
    padding: 0.25rem 0.5rem;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--bg);
    background: var(--ink);
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.1s;
    z-index: 1;
  }
  .balken:hover::after,
  .balken:focus-visible::after,
  .punkt:hover::after,
  .punkt:focus-visible::after {
    opacity: 1;
  }
  .achse {
    margin-top: 0.375rem;
  }
  .jahre {
    display: grid;
    grid-template-columns: repeat(var(--jahre), 1fr);
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }
  /* Auf schmalen Bildschirmen nur jedes zweite Jahr beschriften */
  @media (max-width: 40rem) {
    .jahre span:nth-child(even) {
      visibility: hidden;
    }
  }
</style>
