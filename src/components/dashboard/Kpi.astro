---
interface Props {
  wert: string;
  einheit?: string;
  label: string;
}

const { wert, einheit, label } = Astro.props;
---

<div class="kpi panel">
  <p class="wert">{wert}{einheit && <span class="einheit"> {einheit}</span>}</p>
  <p class="label">{label}</p>
</div>

<style>
  .kpi {
    padding: 1rem 1.25rem 1.125rem;
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }
  .wert {
    margin: 0;
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .einheit {
    font-size: 0.5em;
    font-weight: 400;
    color: var(--muted);
  }
  .label {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--muted);
  }
</style>
