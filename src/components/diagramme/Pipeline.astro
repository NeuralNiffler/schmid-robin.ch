---
interface Props {
  titel: string;
  stufen: readonly { titel: string; text: string }[];
  /** Schmale Variante für die Projektkarten: Stufen immer untereinander. */
  kompakt?: boolean;
}

const { titel, stufen, kompakt = false } = Astro.props;
---

<figure class:list={["pipeline", { kompakt }]}>
  <ol>
    {
      stufen.map((stufe, i) => (
        <li>
          <span class="nr">{i + 1}</span>
          <strong>{stufe.titel}</strong>
          <span class="text">{stufe.text}</span>
        </li>
      ))
    }
  </ol>
  <figcaption>{titel}</figcaption>
</figure>

<style>
  .pipeline {
    margin: 0;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 40rem) {
    ol {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 2rem;
    }
  }
  li {
    position: relative;
    display: grid;
    gap: 0.125rem;
    padding: 0.75rem 0.875rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--k, var(--accent));
    border-radius: 8px;
  }
  /* Pfeil zur nächsten Stufe: nach unten auf dem Handy, nach rechts ab Tablet */
  li:not(:last-child)::after {
    content: "↓";
    position: absolute;
    left: 50%;
    bottom: -1.5rem;
    transform: translateX(-50%);
    color: var(--k, var(--accent));
    font-weight: 600;
  }
  @media (min-width: 40rem) {
    li:not(:last-child)::after {
      content: "→";
      left: auto;
      right: -1.5rem;
      bottom: auto;
      top: 50%;
      transform: translateY(-50%);
    }
  }
  .nr {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }
  strong {
    font-family: var(--serif);
    font-weight: 600;
  }
  .text {
    font-size: 0.875rem;
    color: var(--muted);
  }
  figcaption {
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .kompakt {
    padding: 0.875rem;
  }
  .kompakt ol {
    grid-auto-flow: row;
    gap: 0.875rem;
  }
  .kompakt li {
    grid-template-columns: auto 1fr;
    column-gap: 0.5rem;
    align-items: baseline;
    padding: 0.375rem 0.625rem;
    border-top: 1px solid var(--line);
    border-left: 3px solid var(--k, var(--accent));
  }
  .kompakt li:not(:last-child)::after {
    content: "↓";
    left: 1.25rem;
    right: auto;
    top: auto;
    bottom: -0.875rem;
    transform: none;
    font-size: 0.75rem;
    line-height: 0.875rem;
  }
  .kompakt strong {
    font-size: 0.9375rem;
  }
  /* Erklärung als zweite Zeile unter dem Titel, eingerückt auf Höhe des Titels */
  .kompakt .text {
    grid-column: 2;
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .kompakt figcaption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
  }
</style>
