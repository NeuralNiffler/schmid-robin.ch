---
import { existsSync } from "node:fs";
import { siteConfig } from "../site.config";

const { email, linkedin, github } = siteConfig.links;
// Foto ist optional: Wird public/portrait.jpg abgelegt, erscheint es automatisch.
const hatPortrait = existsSync(new URL(`../../public${siteConfig.portrait}`, import.meta.url));
---

<section class="hero container">
  <div class="text">
    <p class="eyebrow">{siteConfig.ort}</p>
    <h1>{siteConfig.name}</h1>
    <p class="positionierung">{siteConfig.positionierung}</p>
    {siteConfig.profil.map((absatz) => <p class="profil">{absatz}</p>)}
    <ul class="actions">
      <li><a class="button button--primary" href="#projekte">Projekte ansehen</a></li>
      <li><a class="button" href={linkedin} target="_blank" rel="me noopener">LinkedIn</a></li>
      <li><a class="button" href={github} target="_blank" rel="me noopener">GitHub</a></li>
      <li><a class="button" href={`mailto:${email}`}>E-Mail</a></li>
    </ul>
  </div>
  <div class="portrait" aria-hidden={hatPortrait ? undefined : "true"}>
    {
      hatPortrait ? (
        <img src={siteConfig.portrait} alt={`Porträt von ${siteConfig.name}`} width="320" height="320" />
      ) : (
        <span class="initialen">RS</span>
      )
    }
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1fr 16rem;
      gap: 4rem;
      padding-top: 5rem;
      padding-bottom: 4rem;
    }
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin: 0 0 0.5rem;
  }
  .positionierung {
    font-family: var(--serif);
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--accent);
    margin: 0 0 1.5rem;
  }
  .profil {
    max-width: 38rem;
    margin: 0 0 1rem;
    color: var(--ink);
  }
  .actions {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .portrait {
    order: -1;
    width: 7rem;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--accent-soft);
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .portrait {
      order: 0;
      width: 100%;
    }
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initialen {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2rem, 6vw, 4.5rem);
    color: var(--accent);
  }
</style>
