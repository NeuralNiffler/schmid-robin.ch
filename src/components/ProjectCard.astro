---
import type { CollectionEntry } from "astro:content";
import Diagramm from "./Diagramm.astro";

interface Props {
  projekt: CollectionEntry<"projects">;
  /** Laufnummer für die Kopfzeile, beginnend bei 1. */
  nr: number;
}

const { projekt, nr } = Astro.props;
const { titel, kurz, kontext, zeitraum, stack, bild, bildAlt, diagramm, featured } = projekt.data;
const href = `/projekte/${projekt.id}/`;
---

<article class:list={["card", { featured }]} data-kontext={kontext}>
  <p class="kopf mono">
    <span>P-{String(nr).padStart(2, "0")}</span>
    <span class="badge">{kontext}</span>
    <span class="zeitraum">{zeitraum}</span>
  </p>
  <div class="body">
    <h3><a href={href}>{titel}</a></h3>
    <p class="kurz">{kurz}</p>
    <div class="medium">
      {
        bild ? (
          <img class="bild" src={bild} alt={bildAlt ?? ""} loading="lazy" decoding="async" width="800" height="450" />
        ) : (
          diagramm && <Diagramm name={diagramm} kompakt />
        )
      }
    </div>
    <ul class="tags" aria-label="Stack">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
    <span class="mehr mono" aria-hidden="true">details →</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    /* Zeilen mit den Nachbarkarten teilen, damit Bild/Diagramm fluchten */
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--k);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--k);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-within {
      transform: none;
    }
  }
  .kopf {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .zeitraum {
    margin-left: auto;
  }
  .bild {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .body {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0.75rem;
    padding: 1.25rem;
  }
  .medium {
    align-self: start;
  }
  h3 {
    margin: 0;
    font-size: 1.3125rem;
  }
  .featured h3 {
    font-size: 1.5rem;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  /* Ganze Karte klickbar, ohne verschachtelte Links */
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .kurz {
    margin: 0;
    color: var(--muted);
  }
  .tags {
    /* nicht auf Zeilenhöhe strecken, sonst blähen sich die Tags auf */
    align-self: start;
    padding-top: 0.25rem;
  }
  .mehr {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
