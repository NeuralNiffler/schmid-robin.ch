---
import Pipeline from "./diagramme/Pipeline.astro";

interface Props {
  name: "5000ratshuus" | "bc365" | "cowork" | "shiny" | "bfs" | "adbrief";
  kompakt?: boolean;
}

/**
 * Einfache Fluss-Schemas für Projekte, optional zusätzlich zum Screenshot.
 * Jede Stufe: Titel und kurze Zeile darunter.
 */
const schemas = {
  "5000ratshuus": {
    titel: "Ablauf vom Newsletter zum Artikel",
    stufen: [
      { titel: "Newsletter", text: "E-Mail der Stadt" },
      { titel: "Worker", text: "prüft Absender und Inhalt" },
      { titel: "GitHub Action", text: "Artikel mit Claude" },
      { titel: "Cloudflare", text: "Build und Deploy" },
    ],
  },
  bc365: {
    titel: "Datenfluss vor und nach der Migration",
    stufen: [
      { titel: "Kernsystem", text: "eigenes ERP-nahes System" },
      { titel: "Schnittstelle", text: "XML-Files → REST-API" },
      { titel: "Buchhaltung", text: "Navision on-prem → BC365 SaaS" },
    ],
  },
  cowork: {
    titel: "Beispiel: Arbeitszeit der Woche prüfen",
    stufen: [
      { titel: "Auftrag", text: "«Prüf meine Zeiterfassung dieser Woche»" },
      { titel: "Bereich", text: "Claude lädt die Regeln für Arbeit" },
      { titel: "Skill", text: "holt Daten aus Jira, Slack und Kalender" },
      { titel: "Vorschlag", text: "Prüfen und erfassen / korrigieren" },
    ],
  },
  shiny: {
    titel: "Von den OWID-Daten zur Shiny-App",
    stufen: [
      { titel: "Our World in Data", text: "Schuljahre, BIP, Lebenserwartung" },
      { titel: "Aufbereitung", text: "Quarto und tidyverse" },
      { titel: "Analyse", text: "Korrelationen 2011–2023" },
      { titel: "Shiny-App", text: "interaktive Exploration" },
    ],
  },
  bfs: {
    titel: "Von den BFS-Rohdaten zu den finalen Grafiken",
    stufen: [
      { titel: "BFS-Daten", text: "Strukturerhebung 2010–2022" },
      { titel: "Preprocessing", text: "R-Skripte in Folge, je ein .rds" },
      { titel: "Anreicherung", text: "Gemeindetyp und Sprachregion" },
      { titel: "Final Plots", text: "R Markdown, Abschlussgrafiken" },
    ],
  },
  adbrief: {
    titel: "Von den Rohdaten zum Report",
    stufen: [
      { titel: "Input", text: "Excel oder JSON" },
      { titel: "Einlesen", text: "einheitliche Struktur" },
      { titel: "Kennzahlen", text: "z. B. Kosten pro Klick" },
      { titel: "HTML-Report", text: "gerendert mit Quarto" },
    ],
  },
} as const;

const schema = schemas[Astro.props.name];
---

<Pipeline titel={schema.titel} stufen={schema.stufen} kompakt={Astro.props.kompakt} />
