---
import Base from "../layouts/Base.astro";
---

<Base title="Seite nicht gefunden" noindex>
  <section class="container nf">
    <p class="eyebrow">404</p>
    <h1>Diese Seite gibt es nicht.</h1>
    <p>Vielleicht hat sich die Adresse geändert. Hier geht es zu den <a href="/#projekte">Projekten</a>.</p>
  </section>
</Base>

<style>
  .nf {
    padding-top: 5rem;
    max-width: 42rem;
  }
  h1 {
    font-size: 2.25rem;
    margin: 0 0 1rem;
  }
</style>
