---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Diagramm from "../../components/Diagramm.astro";
import { getProjekte } from "../../lib";

export const getStaticPaths = (async () => {
  const projekte = await getProjekte();
  return projekte.map((projekt, i) => ({
    params: { slug: projekt.id },
    props: { projekt, naechstes: projekte[(i + 1) % projekte.length] },
  }));
}) satisfies GetStaticPaths;

const { projekt, naechstes } = Astro.props;
const { titel, kurz, kontext, zeitraum, problem, rolle, ergebnis, stack, links, bild, bildAlt, diagramm } =
  projekt.data;
const { Content } = await render(projekt);
---

<Base title={titel} description={kurz}>
  <article class="projekt container" data-kontext={kontext}>
    <a class="zurueck mono" href="/#projekte">← alle projekte</a>
    <header>
      <p class="meta"><span class="badge">{kontext}</span> <span>{zeitraum}</span></p>
      <h1>{titel}</h1>
      <p class="kurz">{kurz}</p>
      {
        links.length > 0 && (
          <ul class="links">
            {links.map((l) => (
              <li>
                <a class="button" href={l.url}>
                  {l.label} ↗
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {bild && <img class="bild" src={bild} alt={bildAlt ?? ""} width="1200" height="675" />}
    {!bild && diagramm && <div class="diagramm"><Diagramm name={diagramm} /></div>}

    <dl class="eckdaten">
      <div>
        <dt>Ausgangslage</dt>
        <dd>{problem}</dd>
      </div>
      <div>
        <dt>Meine Rolle</dt>
        <dd>{rolle}</dd>
      </div>
      <div>
        <dt>Ergebnis</dt>
        <dd>{ergebnis}</dd>
      </div>
      <div>
        <dt>Stack</dt>
        <dd>
          <ul class="tags">{stack.map((s) => <li>{s}</li>)}</ul>
        </dd>
      </div>
    </dl>

    <div class="inhalt">
      <Content />
    </div>

    {
      naechstes.id !== projekt.id && (
        <nav class="weiter" aria-label="Nächstes Projekt">
          <span class="eyebrow">Nächstes Projekt</span>
          <a href={`/projekte/${naechstes.id}/`}>{naechstes.data.titel} →</a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .projekt {
    max-width: 48rem;
    padding-top: 2rem;
  }
  .zurueck {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.875rem;
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin: 0 0 0.75rem;
  }
  .kurz {
    font-size: 1.1875rem;
    color: var(--muted);
    margin: 0;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .bild,
  .diagramm {
    margin-top: 2.5rem;
  }
  .bild {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .projekt :global(.pipeline) {
    background: var(--surface);
  }
  .eckdaten {
    display: grid;
    gap: 1rem;
    margin: 2.5rem 0 0;
  }
  @media (min-width: 40rem) {
    .eckdaten {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .eckdaten > div {
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--k);
    border-radius: var(--radius);
    padding: 1rem 1.25rem 1.25rem;
  }
  dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  dd {
    margin: 0;
  }
  .inhalt {
    margin-top: 2.5rem;
  }
  .inhalt :global(h2) {
    font-size: 1.5rem;
    margin: 2.5rem 0 0.75rem;
  }
  .inhalt :global(p),
  .inhalt :global(li) {
    max-width: 42rem;
  }
  .inhalt :global(li + li) {
    margin-top: 0.375rem;
  }
  .weiter {
    display: grid;
    gap: 0.25rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .weiter a {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
  }
</style>
